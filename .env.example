# ==============================================================================
# Alpaca Swing Pilot - 环境变量配置模板 (Configuration Template)
# 复制本文件为 .env 并填入你的 Alpaca Paper Trading 密钥：
# cp .env.example .env
# ==============================================================================

# 1. Alpaca API 密钥 (从 https://app.alpaca.markets/paper/dashboard/overview 获取)
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here

# 强制开启模拟盘保护 (true = Paper Trading 模拟盘, false = 实盘)
ALPACA_PAPER=true

# 2. 交易标的池 (英文逗号分隔，默认精选高流动性大盘 ETF 与科技巨头，远离垃圾股)
TRADING_SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA,GOOGL,AMZN
BENCHMARK_SYMBOL=SPY

# 3. 策略选择:
#   - rsi_pullback : 均值回归策略 (MA200长期牛市过滤 + 短期RSI超卖抄底，高胜率低买高卖)
#   - sma_cross    : 趋势跟踪策略 (MA20/MA50双均线金叉买入死叉卖出，顺势吃大波段)
#   - hybrid       : 融合策略 (上升趋势确认 + 回调买入)
DEFAULT_STRATEGY=rsi_pullback

# 4. 核心风控铁闸 (Risk Management Guardrails)
MAX_POSITIONS=5
MAX_POSITION_PCT=0.20
STOP_LOSS_PCT=0.08
TRAILING_STOP_PCT=0.18

# 5. Phase 2: 本地 OpenAI 兼容 LLM 新闻风控守门员 (Local LLM News Guard)
LLM_BASE_URL=http://localhost:11435/v1
LLM_MODEL_ID=qwen3.8-flash-next-iq2_xs
